<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_membership_wizard_form" model="ir.ui.view">
        <field name="name">gym.membership.wizard.form</field>
        <field name="model">gym.membership.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Membership">
                <sheet>
                    <group string="Member Information">
                        <group>
                            <field name="member_id" options="{'no_create': True}"/>
                            <field name="membership_type_id" options="{'no_create': True}"/>
                            <field name="date_start"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="trainer_id" options="{'no_create': True}"/>
                            <field name="trainer_fee" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Options">
                        <field name="create_invoice"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_purchase_membership"
                        string="Purchase Membership"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gym_membership_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Membership</field>
        <field name="res_model">gym.membership.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
