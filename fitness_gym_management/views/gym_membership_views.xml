<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Membership Type Views -->
    <record id="view_gym_membership_type_tree" model="ir.ui.view">
        <field name="name">gym.membership.type.tree</field>
        <field name="model">gym.membership.type</field>
        <field name="arch" type="xml">
            <list string="Membership Types">
                <field name="name"/>
                <field name="duration"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gym_membership_type_form" model="ir.ui.view">
        <field name="name">gym.membership.type.form</field>
        <field name="model">gym.membership.type</field>
        <field name="arch" type="xml">
            <form string="Membership Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="duration"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gym_membership_type_kanban" model="ir.ui.view">
        <field name="name">gym.membership.type.kanban</field>
        <field name="model">gym.membership.type</field>
        <field name="arch" type="xml">
            <kanban string="Membership Types">
                <field name="name"/>
                <field name="duration"/>
                <field name="price"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="row g-0">
                        <div class="col-3 d-flex align-items-center justify-content-center">
                            <i class="fa fa-id-card fa-3x text-primary" title="fa-id-card fa-3x text-primary"/>
                        </div>
                        <div class="col ps-2">
                            <strong><field name="name"/></strong>
                            <div><field name="duration"/> days</div>
                            <div><field name="price"/> </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gym_membership_type_search" model="ir.ui.view">
        <field name="name">gym.membership.type.search</field>
        <field name="model">gym.membership.type</field>
        <field name="arch" type="xml">
            <search string="Membership Types">
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_gym_membership_type" model="ir.actions.act_window">
        <field name="name">Membership Types</field>
        <field name="res_model">gym.membership.type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Membership Views -->
    <record id="view_gym_membership_tree" model="ir.ui.view">
        <field name="name">gym.membership.tree</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <list string="Memberships" decoration-success="state == 'active'" decoration-danger="state == 'expired'" decoration-muted="state in ('cancelled', 'draft')">
                <field name="ref"/>
                <field name="member_id"/>
                <field name="membership_type_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" optional="hide"/>
                <field name="trainer_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'" decoration-warning="state == 'draft'" decoration-muted="state == 'cancelled'"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>

    <record id="view_gym_membership_form" model="ir.ui.view">
        <field name="name">gym.membership.form</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <form string="Membership">
                <header>
                    <button
                        name="action_create_invoice"
                        string="Create Invoice"
                        type="object"
                        class="btn-primary"
                        invisible="invoice_id != False"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel Membership"
                        type="object"
                        class="btn-danger"
                        invisible="state == 'cancelled'"
                        confirm="Are you sure you want to cancel this membership?"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1>
                            <field name="ref" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Membership Details">
                            <field name="member_id" options="{'no_create': True}"/>
                            <field name="membership_type_id" options="{'no_create': True}"/>
                            <field name="date_start"/>
                            <field name="date_end" readonly="1"/>
                        </group>
                        <group string="Financial Details">
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Trainer">
                            <field name="trainer_id" options="{'no_create': True}"/>
                            <field name="trainer_fee" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_membership_kanban" model="ir.ui.view">
        <field name="name">gym.membership.kanban</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <kanban string="Memberships" default_group_by="state">
                <field name="ref"/>
                <field name="member_id"/>
                <field name="membership_type_id"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="price"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="member_id"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="ref"/>
                                </div>
                                <div>Type: <field name="membership_type_id"/></div>
                                <div>Expires: <field name="date_end"/></div>
                                <div>Fee: <field name="price"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gym_membership_search" model="ir.ui.view">
        <field name="name">gym.membership.search</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <search string="Memberships">
                <field name="ref"/>
                <field name="member_id"/>
                <field name="membership_type_id"/>
                <field name="trainer_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                    <filter string="Membership Type" name="group_type" context="{'group_by': 'membership_type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Start Month" name="group_start" context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_membership" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">gym.membership</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
