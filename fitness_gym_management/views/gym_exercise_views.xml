<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_exercise_tree" model="ir.ui.view">
        <field name="name">gym.exercise.tree</field>
        <field name="model">gym.exercise</field>
        <field name="arch" type="xml">
            <list string="Exercises">
                <field name="name"/>
                <field name="exercise_type_id"/>
                <field name="body_part_ids" widget="many2many_tags"/>
                <field name="duration"/>
                <field name="calories_burned"/>
                <field name="difficulty"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gym_exercise_form" model="ir.ui.view">
        <field name="name">gym.exercise.form</field>
        <field name="model">gym.exercise</field>
        <field name="arch" type="xml">
            <form string="Exercise">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Exercise Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Exercise Details">
                            <field name="exercise_type_id" options="{'no_create': True}"/>
                            <field name="difficulty"/>
                            <field name="duration"/>
                            <field name="calories_burned"/>
                            <field name="active"/>
                        </group>
                        <group string="Target &amp; Equipment">
                            <field name="body_part_ids" widget="many2many_tags"/>
                            <field name="equipment_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions" name="instructions">
                            <group>
                                <group string="Benefits">
                                    <field name="benefits" nolabel="1"/>
                                </group>
                                <group string="Steps">
                                    <field name="steps" nolabel="1"/>
                                </group>
                            </group>
                            <group string="Video">
                                <field name="video_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gym_exercise_kanban" model="ir.ui.view">
        <field name="name">gym.exercise.kanban</field>
        <field name="model">gym.exercise</field>
        <field name="arch" type="xml">
            <kanban string="Exercises">
                <field name="name"/>
                <field name="exercise_type_id"/>
                <field name="difficulty"/>
                <field name="calories_burned"/>
                <field name="duration"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="exercise_type_id"/>
                                </div>
                                <div>Difficulty: <field name="difficulty"/></div>
                                <div>Duration: <field name="duration"/> min</div>
                                <div>Calories: <field name="calories_burned"/> kcal</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gym_exercise_search" model="ir.ui.view">
        <field name="name">gym.exercise.search</field>
        <field name="model">gym.exercise</field>
        <field name="arch" type="xml">
            <search string="Exercises">
                <field name="name"/>
                <field name="exercise_type_id"/>
                <field name="body_part_ids"/>
                <field name="equipment_ids"/>
                <filter string="Beginner" name="beginner" domain="[('difficulty', '=', 'beginner')]"/>
                <filter string="Intermediate" name="intermediate" domain="[('difficulty', '=', 'intermediate')]"/>
                <filter string="Advanced" name="advanced" domain="[('difficulty', '=', 'advanced')]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Exercise Type" name="group_type" context="{'group_by': 'exercise_type_id'}"/>
                    <filter string="Difficulty" name="group_difficulty" context="{'group_by': 'difficulty'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_exercise" model="ir.actions.act_window">
        <field name="name">Exercises</field>
        <field name="res_model">gym.exercise</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
