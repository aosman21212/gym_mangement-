<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gym_trainer_list" model="ir.ui.view">
        <field name="name">gym.trainer.list</field>
        <field name="model">gym.trainer</field>
        <field name="arch" type="xml">
            <list string="Trainers">
                <field name="ref"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="specialization"/>
                <field name="joining_date"/>
                <field name="trainer_fee"/>
                <field name="member_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gym_trainer_form" model="ir.ui.view">
        <field name="name">gym.trainer.form</field>
        <field name="model">gym.trainer</field>
        <field name="arch" type="xml">
            <form string="Trainer">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_members"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                        >
                            <field name="member_count" widget="statinfo" string="Members"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Trainer Name"/>
                        </h1>
                        <div>
                            <field name="ref" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="partner_id"/>
                            <field name="gender"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="Professional Information">
                            <field name="specialization"/>
                            <field name="joining_date"/>
                            <field name="trainer_fee"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Skills" name="skills">
                            <field name="skill_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_trainer_kanban" model="ir.ui.view">
        <field name="name">gym.trainer.kanban</field>
        <field name="model">gym.trainer</field>
        <field name="arch" type="xml">
            <kanban string="Trainers">
                <field name="name"/>
                <field name="ref"/>
                <field name="phone"/>
                <field name="specialization"/>
                <field name="member_count"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="kanban_image('gym.trainer', 'image_1920', record.id.raw_value)" alt="Trainer"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="o_kanban_record_subtitle">
                                <field name="specialization"/>
                            </div>
                            <div>Phone: <field name="phone"/></div>
                            <div>Members: <field name="member_count"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gym_trainer_search" model="ir.ui.view">
        <field name="name">gym.trainer.search</field>
        <field name="model">gym.trainer</field>
        <field name="arch" type="xml">
            <search string="Trainers">
                <field name="name"/>
                <field name="ref"/>
                <field name="specialization"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Specialization" name="group_specialization" context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_trainer" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">gym.trainer</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
