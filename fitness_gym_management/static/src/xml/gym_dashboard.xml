<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fitness_gym_management.GymDashboard">
        <div class="o_gym_dashboard o_action p-4 overflow-auto">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <i class="fa fa-heartbeat fa-2x text-danger me-3"/>
                <div>
                    <h2 class="mb-0 fw-bold">Gym Management</h2>
                    <small class="text-muted">Overview Dashboard</small>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height:200px">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>

            <t t-else="">
                <!-- Section: Members -->
                <h5 class="text-uppercase text-muted fw-semibold mb-3 small">
                    <i class="fa fa-users me-1"/> Members
                </h5>
                <div class="row g-3 mb-4">
                    <!-- Total Members -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="() => this.openMembers()">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-primary bg-opacity-10 d-flex">
                                    <i class="fa fa-users fa-lg text-primary"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-primary" t-esc="state.total_members"/>
                                    <div class="text-muted small mt-1">Total Members</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Active Members -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="() => this.openMembers('active')">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-success bg-opacity-10 d-flex">
                                    <i class="fa fa-check-circle fa-lg text-success"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-success" t-esc="state.active_members"/>
                                    <div class="text-muted small mt-1">Active Members</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Expired Members -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="() => this.openMembers('expired')">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-danger bg-opacity-10 d-flex">
                                    <i class="fa fa-times-circle fa-lg text-danger"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-danger" t-esc="state.expired_members"/>
                                    <div class="text-muted small mt-1">Expired Members</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Inactive Members -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="() => this.openMembers('inactive')">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-secondary bg-opacity-10 d-flex">
                                    <i class="fa fa-minus-circle fa-lg text-secondary"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-secondary" t-esc="state.inactive_members"/>
                                    <div class="text-muted small mt-1">Inactive Members</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section: Operations -->
                <h5 class="text-uppercase text-muted fw-semibold mb-3 small">
                    <i class="fa fa-cogs me-1"/> Operations
                </h5>
                <div class="row g-3 mb-4">
                    <!-- Trainers -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="openTrainers">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-info bg-opacity-10 d-flex">
                                    <i class="fa fa-id-badge fa-lg text-info"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-info" t-esc="state.total_trainers"/>
                                    <div class="text-muted small mt-1">Trainers</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Active Memberships -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="() => this.openMemberships('active')">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-warning bg-opacity-10 d-flex">
                                    <i class="fa fa-id-card fa-lg text-warning"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-warning" t-esc="state.active_memberships"/>
                                    <div class="text-muted small mt-1">Active Memberships</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Workout Plans -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="openWorkoutPlans">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-primary bg-opacity-10 d-flex">
                                    <i class="fa fa-heartbeat fa-lg text-primary"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-primary" t-esc="state.workout_plans"/>
                                    <div class="text-muted small mt-1">Workout Plans</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Diet Plans -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 o_dashboard_card" t-on-click="openDietPlans">
                            <div class="card-body d-flex align-items-center gap-3 p-3">
                                <div class="rounded-3 p-3 bg-success bg-opacity-10 d-flex">
                                    <i class="fa fa-cutlery fa-lg text-success"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold lh-1 text-success" t-esc="state.diet_plans"/>
                                    <div class="text-muted small mt-1">Diet Plans</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-bottom-0">
                        <h6 class="mb-0 fw-semibold">
                            <i class="fa fa-bolt text-warning me-2"/>Quick Actions
                        </h6>
                    </div>
                    <div class="card-body d-flex flex-wrap gap-2 pt-3">
                        <button class="btn btn-primary btn-sm" t-on-click="() => this.openMembers()">
                            <i class="fa fa-users me-1"/> All Members
                        </button>
                        <button class="btn btn-success btn-sm" t-on-click="() => this.openMembers('active')">
                            <i class="fa fa-check-circle me-1"/> Active Members
                        </button>
                        <button class="btn btn-danger btn-sm" t-on-click="() => this.openMembers('expired')">
                            <i class="fa fa-times-circle me-1"/> Expired Members
                        </button>
                        <button class="btn btn-info btn-sm text-white" t-on-click="openTrainers">
                            <i class="fa fa-id-badge me-1"/> Trainers
                        </button>
                        <button class="btn btn-warning btn-sm" t-on-click="() => this.openMemberships()">
                            <i class="fa fa-id-card me-1"/> Memberships
                        </button>
                        <button class="btn btn-outline-primary btn-sm" t-on-click="openWorkoutPlans">
                            <i class="fa fa-heartbeat me-1"/> Workout Plans
                        </button>
                        <button class="btn btn-outline-success btn-sm" t-on-click="openDietPlans">
                            <i class="fa fa-cutlery me-1"/> Diet Plans
                        </button>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>
